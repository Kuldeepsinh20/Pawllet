# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/pawlet_db

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://pawlet-inky.vercel.app,http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=../storage/uploads

# ── Upload Limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE=10485760

# ── Authentication & Security ─────────────────────────────────────────────────
JWT_SECRET_KEY=generate_a_secure_random_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Seed Credentials
ADMIN_USERNAME=Pawllet@care
ADMIN_PASSWORD=pawlletpetcare
